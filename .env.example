# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL
POSTGRES_DB=reports
POSTGRES_USER=reports
POSTGRES_PASSWORD=reports
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# LLM (analyse des fichiers CSV/Excel et génération des rapports)
LLM_API_KEY=

# Email (ingestion des fichiers attachés + envoi des rapports)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=reports@example.com

# Frontend
VITE_API_BASE_URL=http://localhost:8000
